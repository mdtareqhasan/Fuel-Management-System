# ---------------------------------------------------------------------------
# Copy this file to .env and adjust. NEVER commit a real .env.
# Every value here is a SAFE DEFAULT for the local demo.
# ---------------------------------------------------------------------------

# --- Simulator (official image, unmodified) -------------------------------
SIMULATOR_IMAGE=asifmahmoud414/bup-fuel-supply-simulator:1.0.0
# Wall-clock ticks per second while RUNNING.
# NOTE: this is an upper bound. The measured sustained rate on a typical
# dev machine at speed 8 is ~5.46 ticks/sec. See docs/contract-notes.md sec 2.
SIMULATION_SPEED=8
# Simulated minutes advanced per tick. The simulator reports this back on
# GET /v1/instance as tick_minutes -- always assert it matches.
TICK_MINUTES=15
# paused | running. Keep "paused" for deterministic demos and tests.
SIMULATOR_START_MODE=paused

# --- Backend ---------------------------------------------------------------
# Host-side URL for the simulator.
SIMULATOR_BASE_URL=http://localhost:8000
# URL as seen from inside the compose network.
SIMULATOR_BASE_URL_INTERNAL=http://simulator-api:8000
SERVER_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75

# --- Database --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/fuelplatform
DB_USER=fuel
DB_PASSWORD=fuel_local_dev_only
DB_PORT=5432

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=5173
# Port the built frontend is served on inside compose.
FRONTEND_INTERNAL_PORT=80

# --- Monitoring ------------------------------------------------------------
# 9090 is the Prometheus scrape port. Grafana is 3000.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_local_dev_only
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_DOMAIN=localhost

# --- Application policy defaults (tunable, see ADR 004) --------------------
# Wall-clock age after which approval is blocked, in seconds. Wall clock, not
# ticks -- so it behaves identically while PAUSED and while RUNNING.
FRESHNESS_MAX_AGE_SECONDS=10
# Minimum interval between refreshes triggered by coalesced tick events.
REFRESH_MIN_INTERVAL_MS=500
# Fallback REST poll interval while the SSE stream is down.
POLL_INTERVAL_MS=2000
# Simulated horizon for risk projection, in hours.
PROJECTION_HORIZON_HOURS=8
# Connection and response timeouts for simulator calls, in milliseconds.
SIMULATOR_CONNECT_TIMEOUT_MS=1000
SIMULATOR_RESPONSE_TIMEOUT_MS=2000
